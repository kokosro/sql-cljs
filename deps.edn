{:paths ["src"]
 ;; sql-cljs is pure ClojureScript: it formats data into SQL text and needs
 ;; nothing at run time beyond ClojureScript itself. No promesa, no core.async
 ;; (nothing in this library is asynchronous), no npm package.
 :deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
 :aliases
 {;; Development: shadow-cljs compiler. Use via
  ;; `clojure -M:dev -m shadow.cljs.devtools.cli watch dev`. NOTE: shadow-cljs.edn is
  ;; standalone (no :deps) and declares the same (empty) dependency set itself for
  ;; `npx shadow-cljs ...`.
  :dev {:extra-paths ["test" "dev"]
        :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}}}
  ;; Tests: same toolchain plus the test source path.
  :test {:extra-paths ["test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}}}}}
